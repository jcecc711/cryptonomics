# systemd unit for the trading loop. Edit User and WorkingDirectory, then:
#   sudo cp deploy/cryptonomics-*.service /etc/systemd/system/
#   sudo systemctl enable --now cryptonomics-bot cryptonomics-web
[Unit]
Description=Cryptonomics trading bot
After=network-online.target
Wants=network-online.target

[Service]
User=crypto
WorkingDirectory=/opt/cryptonomics
ExecStart=/usr/bin/python3 -m bot.run loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
