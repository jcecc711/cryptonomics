# Copy to .env and fill in. Never commit .env.

# paper (default, simulated against the live order book) or live (real orders).
# BOT_MODE is the default for both strategies; override each one separately,
# e.g. core live while the swing layer keeps paper trading:
BOT_MODE=paper
BOT_CORE_MODE=
BOT_SWING_MODE=

# Binance.US API key: enable trading, DISABLE withdrawals, restrict to your server's IP.
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# Pair. BTCUSDT has the most volume on Binance.US; use BTCUSD + BOT_QUOTE=USD to trade dollars directly.
BOT_SYMBOL=BTCUSDT
BOT_BASE=BTC
BOT_QUOTE=USDT

# Core strategy: daily DI crossover (tested values)
BOT_DI_LEN=38
BOT_ADX_SMOOTHING=9
# false: if started while DI+ is already above DI-, wait for the next fresh cross up
BOT_JOIN_OPEN_TREND=false
BOT_CORE_SHARE=0.7          # share of the account the core trades

# Swing layer: 4h EMA crossover, only while the daily DI trend is up
BOT_SWING_ENABLED=true
BOT_SWING_SHARE=0.3
BOT_SWING_FAST=8
BOT_SWING_SLOW=21
BOT_SWING_MAKER_TIMEOUT_MIN=15

# Safety
BOT_MAX_ORDER_USD=1000000   # hard cap per buy, per strategy; set low for a first live run

# Execution
BOT_MAKER_TIMEOUT_MIN=60    # core: work a 0%-fee maker order this long
BOT_TAKER_FALLBACK=true     # then cross the spread (0.02% fee) if still unfilled
BOT_MAX_SLIPPAGE=0.002

# Paper trading starting balance (split between the strategies by their shares)
BOT_PAPER_START_USD=10000

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=
